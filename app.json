{
  "expo": {
    "name": "Spendly",
    "slug": "expense-calculator-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "sdkVersion": "56.0.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.expensecalculator",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Authenticate to access your expense data.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#007AFF"
      },
      "package": "com.ssk.spendly",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Authenticate to access your expense data."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9e388612-0b9f-4ab8-90b2-7d7d16cf3127"
      }
    }
  }
}
